[connection signal="toggled" from="HUD/MP3Player/CheckButton" to="." method="_on_check_button_toggled"]
[connection signal="value_changed" from="HUD/MP3Player/MusicOptions/Master/HScrollBarMaster" to="." method="_on_h_scroll_bar_master_value_changed"]
[connection signal="value_changed" from="HUD/MP3Player/MusicOptions/Music/HScrollBarMusic" to="." method="_on_h_scroll_bar_music_value_changed"]
[connection signal="value_changed" from="HUD/MP3Player/MusicOptions/SFX/HScrollBarSFX" to="." method="_on_h_scroll_bar_sfx_value_changed"]
