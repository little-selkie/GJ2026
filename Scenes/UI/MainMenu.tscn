[connection signal="pressed" from="HUD/MP3Player/MP3Buttons/ButtonRight" to="." method="_on_button_right_pressed"]
[connection signal="pressed" from="HUD/MP3Player/MP3Buttons/ButtonDown" to="." method="_on_button_down_pressed"]
